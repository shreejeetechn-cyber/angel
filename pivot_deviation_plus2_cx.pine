//@version=6
indicator("Pivot Deviation+2 Cx", overlay=true, max_labels_count=200, dynamic_requests=true)

//================ PRESET =================
preset = input.string("Intraday", "Strategy Preset", options=["Scalping", "Intraday", "Swing"])

// PRESET VALUES
devExtreme   = preset == "Scalping" ? 2.0 : preset == "Intraday" ? 3.0 : 4.0
atrMult      = preset == "Scalping" ? 1.0 : preset == "Intraday" ? 1.2 : 1.5
emaLen       = preset == "Scalping" ? 20  : preset == "Intraday" ? 50  : 100
adxMax       = preset == "Scalping" ? 30  : preset == "Intraday" ? 25  : 20
volMult      = preset == "Scalping" ? 1.2 : preset == "Intraday" ? 1.5 : 2.0
cooldownBars = preset == "Scalping" ? 5   : preset == "Intraday" ? 10  : 20

//================ INPUTS =================
pivotTF         = input.timeframe("D", "Pivot TF")
useWeeklyFilter = input.bool(true, "Use Weekly Pivot Filter")
atrLen          = input.int(14, "ATR Length")
adxLen          = input.int(14, "ADX Length")
volLen          = input.int(20, "Volume Avg Length")
sessionFilter   = input.session("0915-1130", "Session Filter")

useVWAPFilter = input.bool(true, "Use VWAP Filter")
showVWAP      = input.bool(true, "Show VWAP")
showHeatmap = input.bool(true, "Heatmap")
showDash    = input.bool(true, "Dashboard")
showLines   = input.bool(true, "Show Lines")
showSignals = input.bool(true, "Show Signal Labels")

// PIVOT DISPLAY
showPivotLevels = input.bool(true, "Show Pivot Levels")
showPivotSR     = input.bool(true, "Show R1 S1")
showPivotSR2    = input.bool(false, "Show R2 S2")
showPivotSR3    = input.bool(false, "Show R3 S3")
showPrevHL      = input.bool(true, "Show Previous Day High Low")

// TABLE SETTINGS
tableOpacity  = input.int(80, "Table Transparency", 0, 100)
tableTextSize = input.string("small", "Table Text Size", options=["tiny", "small", "normal", "large"])
tablePos      = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

pos     = tablePos == "Top Right" ? position.top_right : tablePos == "Top Left" ? position.top_left : tablePos == "Bottom Right" ? position.bottom_right : position.bottom_left
txtSize = tableTextSize == "tiny" ? size.tiny : tableTextSize == "small" ? size.small : tableTextSize == "large" ? size.large : size.normal
tableBg = color.new(color.black, tableOpacity)

//================ DAILY + WEEKLY DATA =================
[dHigh, dLow, dClose] = request.security(syminfo.tickerid, pivotTF, [high[1], low[1], close[1]])
[wHigh, wLow, wClose] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]])

pivot       = (dHigh + dLow + dClose) / 3
prevHigh    = dHigh
prevLow     = dLow
weeklyPivot = (wHigh + wLow + wClose) / 3

// PIVOT LEVELS
R1 = 2 * pivot - prevLow
S1 = 2 * pivot - prevHigh
R2 = pivot + (prevHigh - prevLow)
S2 = pivot - (prevHigh - prevLow)
R3 = prevHigh + 2 * (pivot - prevLow)
S3 = prevLow - 2 * (prevHigh - pivot)

//================ CORE CALCULATIONS =================
devPercent = pivot != 0 ? (close - pivot) / pivot * 100 : na

atr      = ta.atr(atrLen)
upperATR = pivot + atr * atrMult
lowerATR = pivot - atr * atrMult

emaTrend  = ta.ema(close, emaLen)
trendUp   = close > emaTrend
trendDown = close < emaTrend

[_, _, adx] = ta.dmi(adxLen, adxLen)
rangeMarket = adx < adxMax

vwapValue = ta.vwap(hlc3)
volAvg    = ta.sma(volume, volLen)
volSpike  = volume > volAvg * volMult

lookback  = 10
sweepHigh = high > ta.highest(high[1], lookback)
sweepLow  = low < ta.lowest(low[1], lookback)

inSession = not na(time(timeframe.period, sessionFilter))

extremeUp   = devPercent > devExtreme and close > upperATR
extremeDown = devPercent < -devExtreme and close < lowerATR

weeklyLong  = not useWeeklyFilter or close < weeklyPivot
weeklyShort = not useWeeklyFilter or close > weeklyPivot

longCond  = extremeDown and weeklyLong and trendUp and rangeMarket and sweepLow and volSpike and inSession and (not useVWAPFilter or close < vwapValue)
shortCond = extremeUp and weeklyShort and trendDown and rangeMarket and sweepHigh and volSpike and inSession and (not useVWAPFilter or close > vwapValue)

// COOLDOWN
var int lastSignalBar = na
allowSignal = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
longSignal  = longCond and allowSignal
shortSignal = shortCond and allowSignal

if longSignal or shortSignal
    lastSignalBar := bar_index

prob = math.min(math.abs(devPercent) / devExtreme * 100, 100)

trendStatus = trendUp ? "Bullish" : trendDown ? "Bearish" : "Neutral"
regime      = rangeMarket ? "Range" : "Trending"
volStatus   = volSpike ? "Spike" : "Normal"

//================ PLOTS =================
plot(showLines and showPivotLevels ? pivot : na, "Pivot", color=color.yellow, linewidth=2)
plot(showLines and showPivotSR ? R1 : na, "R1", color=color.red)
plot(showLines and showPivotSR ? S1 : na, "S1", color=color.green)
plot(showLines and showPivotSR2 ? R2 : na, "R2", color=color.red)
plot(showLines and showPivotSR2 ? S2 : na, "S2", color=color.green)
plot(showLines and showPivotSR3 ? R3 : na, "R3", color=color.red)
plot(showLines and showPivotSR3 ? S3 : na, "S3", color=color.green)

plot(showLines and showPrevHL ? prevHigh : na, "Prev High", color=color.purple, linewidth=2)
plot(showLines and showPrevHL ? prevLow : na, "Prev Low", color=color.purple, linewidth=2)

plot(showLines and useWeeklyFilter ? weeklyPivot : na, "Weekly Pivot", color=color.orange)
plot(showLines ? upperATR : na, "ATR Upper", color=color.red)
plot(showLines ? lowerATR : na, "ATR Lower", color=color.green)
plot(showLines and showVWAP ? vwapValue : na, "VWAP", color=color.blue)
plot(showLines ? emaTrend : na, "EMA", color=color.aqua)

bgcolor(showHeatmap and extremeUp ? color.new(color.red, 70) : na)
bgcolor(showHeatmap and extremeDown ? color.new(color.green, 70) : na)

if showSignals and longSignal
    label.new(bar_index, low, "LONG\nDev " + str.tostring(devPercent, "#.##") + "%", style=label.style_label_up, color=color.green, textcolor=color.white)
if showSignals and shortSignal
    label.new(bar_index, high, "SHORT\nDev " + str.tostring(devPercent, "#.##") + "%", style=label.style_label_down, color=color.red, textcolor=color.white)

//================ DASHBOARD =================
var table dash = table.new(pos, 2, 7)
if showDash and barstate.islast
    table.cell(dash, 0, 0, "Preset", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 0, preset, bgcolor=tableBg, text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 1, "Deviation", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 1, str.tostring(devPercent, "#.##") + "%", bgcolor=tableBg, text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 2, "Trend", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 2, trendStatus, bgcolor=tableBg, text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 3, "Regime", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 3, regime, bgcolor=tableBg, text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 4, "Volume", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 4, volStatus, bgcolor=tableBg, text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 5, "Reversion", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 5, str.tostring(prob, "#") + "%", bgcolor=tableBg, text_color=color.white, text_size=txtSize)

    table.cell(dash, 0, 6, "Pivot", bgcolor=tableBg, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 6, str.tostring(pivot, "#.##"), bgcolor=tableBg, text_color=color.white, text_size=txtSize)

alertcondition(longSignal, "Pivot Buy", "Extreme negative deviation + liquidity sweep")
alertcondition(shortSignal, "Pivot Sell", "Extreme positive deviation + liquidity sweep")

//================ WATCHLIST (IMPROVED LOOP VERSION) =================
showWatchlist = input.bool(true, "Show Mini Watchlist")
watchTrendEmaLen = input.int(50, "Watchlist EMA Length", minval=1)
neutralThresholdPct = input.float(0.10, "Neutral Threshold %", minval=0.01, step=0.01)

watchSym1  = input.symbol("NSE:RELIANCE", "Symbol 1")
watchSym2  = input.symbol("NSE:HDFCBANK", "Symbol 2")
watchSym3  = input.symbol("NSE:ICICIBANK", "Symbol 3")
watchSym4  = input.symbol("NSE:TCS", "Symbol 4")
watchSym5  = input.symbol("NSE:INFY", "Symbol 5")
watchSym6  = input.symbol("NSE:SBIN", "Symbol 6")
watchSym7  = input.symbol("NSE:LT", "Symbol 7")
watchSym8  = input.symbol("NSE:ITC", "Symbol 8")
watchSym9  = input.symbol("NSE:AXISBANK", "Symbol 9")
watchSym10 = input.symbol("NSE:NIFTY", "Symbol 10")

string[] watchSymbols = array.from(watchSym1, watchSym2, watchSym3, watchSym4, watchSym5, watchSym6, watchSym7, watchSym8, watchSym9, watchSym10)

watchOpacity = input.int(50, "Watchlist Transparency", 0, 100)
watchBg      = color.new(color.black, watchOpacity)
var table watch = table.new(position.bottom_right, 4, 11)
watchEmaExpr = ta.ema(close, watchTrendEmaLen)

f_trendLabel(_price, _ema, _neutralThresholdFrac) =>
    na(_price) or na(_ema) or _ema == 0 ? "Neutral" : math.abs(_price - _ema) / _ema < _neutralThresholdFrac ? "Neutral" : _price > _ema ? "Bull" : "Bear"

f_rowColor(_trend) =>
    _trend == "Bull" ? color.green : _trend == "Bear" ? color.red : color.white

neutralThresholdFrac = neutralThresholdPct / 100.0

float[] watchCloses = array.new_float(array.size(watchSymbols), na)
float[] watchPivots = array.new_float(array.size(watchSymbols), na)
float[] watchEmas   = array.new_float(array.size(watchSymbols), na)

for i = 0 to array.size(watchSymbols) - 1
    sym = array.get(watchSymbols, i)

    watchCloseVal = request.security(sym, timeframe.period, close)
    watchPivotVal = request.security(sym, "D", (high[1] + low[1] + close[1]) / 3)
    watchEmaVal   = request.security(sym, timeframe.period, watchEmaExpr)

    array.set(watchCloses, i, watchCloseVal)
    array.set(watchPivots, i, watchPivotVal)
    array.set(watchEmas, i, watchEmaVal)

if showWatchlist and barstate.islast
    table.cell(watch, 0, 0, "Symbol", text_color=color.yellow, bgcolor=watchBg)
    table.cell(watch, 1, 0, "Price", text_color=color.yellow, bgcolor=watchBg)
    table.cell(watch, 2, 0, "Dev%", text_color=color.yellow, bgcolor=watchBg)
    table.cell(watch, 3, 0, "Trend", text_color=color.yellow, bgcolor=watchBg)

    for i = 0 to array.size(watchSymbols) - 1
        sym = array.get(watchSymbols, i)
        watchCloseVal = array.get(watchCloses, i)
        watchPivotVal = array.get(watchPivots, i)
        watchEmaVal   = array.get(watchEmas, i)

        watchDev   = watchPivotVal != 0 ? (watchCloseVal - watchPivotVal) / watchPivotVal * 100 : na
        watchTrend = f_trendLabel(watchCloseVal, watchEmaVal, neutralThresholdFrac)
        watchColor = f_rowColor(watchTrend)

        row = i + 1
        table.cell(watch, 0, row, str.tostring(sym), text_color=watchColor, bgcolor=watchBg)
        table.cell(watch, 1, row, str.tostring(watchCloseVal, "#.##"), text_color=watchColor, bgcolor=watchBg)
        table.cell(watch, 2, row, str.tostring(watchDev, "#.##") + "%", text_color=watchColor, bgcolor=watchBg)
        table.cell(watch, 3, row, watchTrend, text_color=watchColor, bgcolor=watchBg)

//================ YEAR AVERAGE + SD ADDON =================
showYearSD = input.bool(true, "Show 1Y Mean + SD")
yearLen    = input.int(250, "Year Length (Days)")

yearMean = ta.sma(close, yearLen)
yearSD   = ta.stdev(close, yearLen)

sd1Up = yearMean + yearSD
sd1Dn = yearMean - yearSD
sd2Up = yearMean + yearSD * 2
sd2Dn = yearMean - yearSD * 2

plot(showYearSD ? yearMean : na, "1Y Mean", color=color.white, linewidth=2)
plot(showYearSD ? sd1Up : na, "+1 SD", color=color.orange)
plot(showYearSD ? sd1Dn : na, "-1 SD", color=color.orange)
plot(showYearSD ? sd2Up : na, "+2 SD", color=color.red)
plot(showYearSD ? sd2Dn : na, "-2 SD", color=color.green)
