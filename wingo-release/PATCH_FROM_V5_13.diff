+"""Offline launch regression checks; no elevation, EXE, or network is used.
+
+Run on Linux or Windows. Win32 APIs are mocked: a real Windows/UAC smoke test
+is still required before describing a Windows installer as validated.
+"""
+from __future__ import annotations
+
+import ctypes
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from app.updater import launcher
+
+
+class FakeWinApi:
+    def __init__(self, *, result=True, handle=12345, error=0):
+        self.result = result
+        self.handle = handle
+        self.error = error
+        self.calls = []
+        self.closed = []
+        self.shell_execute = Mock(side_effect=self._execute)
+        self.close_handle = Mock(side_effect=lambda handle: self.closed.append(handle) or 1)
+
+    def _execute(self, pointer):
+        info = pointer._obj
+        self.calls.append({
+            "size": info.cbSize,
+            "expected_size": ctypes.sizeof(info),
+            "mask": info.fMask,
+            "verb": info.lpVerb,
+            "file": info.lpFile,
+            "params": info.lpParameters,
+            "directory": info.lpDirectory,
+            "show": info.nShow,
+        })
+        info.hProcess = self.handle
+        return self.result
+
+    def dll(self, name, *, use_last_error):
+        if not use_last_error:
+            raise AssertionError("Windows last-error handling must be enabled")
+        if name == "shell32":
+            return SimpleNamespace(ShellExecuteExW=self.shell_execute)
+        if name == "kernel32":
+            return SimpleNamespace(CloseHandle=self.close_handle)
+        raise AssertionError(f"Unexpected DLL: {name}")
+
+    def patches(self):
+        return (
+            patch.object(ctypes, "WinDLL", side_effect=self.dll, create=True),
+            patch.object(ctypes, "get_last_error", return_value=self.error, create=True),
+            patch.object(ctypes, "WinError", side_effect=lambda error: OSError(error, "Win32 launch failed"), create=True),
+        )
+
+
+class ElevationApiTests(unittest.TestCase):
+    def _launch(self, api, *, args=None):
+        dll, last_error, win_error = api.patches()
+        with dll, last_error, win_error:
+            launcher._launch_elevated_windows(
+                Path(r"C:\Users\Jane Doe\WINGO\Helper\Updater.exe"),
+                args or ["--pid", "123", "--relaunch"],
+                Path(r"C:\Program Files\WINGO"),
+            )
+
+    def test_runas_completes_launch_and_closes_own_process_handle(self):
+        api = FakeWinApi()
+        self._launch(api)
+        self.assertEqual(len(api.calls), 1)
+        call = api.calls[0]
+        self.assertEqual(call["size"], call["expected_size"])
+        self.assertEqual(call["mask"] & 0x140, 0x140)
+        self.assertEqual(call["verb"], "runas")
+        self.assertEqual(call["file"], r"C:\Users\Jane Doe\WINGO\Helper\Updater.exe")
+        self.assertEqual(call["directory"], r"C:\Program Files\WINGO")
+        self.assertEqual(call["params"], "--pid 123 --relaunch")
+        self.assertEqual(call["show"], 1)
+        self.assertEqual(api.closed, [12345])
+
+    def test_windows_quoting_spaces_backslashes_quotes_and_metacharacters(self):
+        api = FakeWinApi()
+        args = [
+            "--package", r"C:\Users\Jane Doe\file & update.wupd",
+            "--install-dir", "C:\\Program Files\\WINGO\\",
+            "--current-version", "5.13", "--target-version", '5.14"beta',
+            "--pid", "123", "--relaunch",
+        ]
+        self._launch(api, args=args)
+        self.assertEqual(
+            api.calls[0]["params"],
+            r'--package "C:\Users\Jane Doe\file & update.wupd" --install-dir "C:\Program Files\WINGO\\" --current-version 5.13 --target-version 5.14\"beta --pid 123 --relaunch',
+        )
+
+    def test_uac_cancellation_raises_so_caller_keeps_wingo_open(self):
+        api = FakeWinApi(result=False, handle=0, error=1223)
+        with self.assertRaises(OSError) as caught:
+            self._launch(api)
+        self.assertEqual(caught.exception.errno, 1223)
+        self.assertIn("cancelled", str(caught.exception))
+        self.assertEqual(api.closed, [])
+
+    def test_other_windows_errors_propagate(self):
+        api = FakeWinApi(result=False, handle=0, error=5)
+        with self.assertRaises(OSError) as caught:
+            self._launch(api)
+        self.assertEqual(caught.exception.errno, 5)
+        self.assertEqual(api.closed, [])
+
+    def test_success_without_process_handle_does_not_report_launched(self):
+        api = FakeWinApi(result=True, handle=0)
+        with self.assertRaisesRegex(RuntimeError, "process handle"):
+            self._launch(api)
+        self.assertEqual(api.closed, [])
+
+
+class LaunchRoutingTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="wingo-updater-launch-")
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.install = self.root / "Program Files & WINGO"
+        self.install.mkdir()
+        self.package = self.root / "update & package.wupd"
+        self.package.write_bytes(b"NOT EXECUTED OR INSTALLED")
+        self.updater = self.install / "WINGOUpdater.exe"
+        self.updater.write_bytes(b"FAKE HELPER, MUST NEVER BE EXECUTED")
+        self.storage_patch = patch.object(launcher, "default_update_root", return_value=self.root / "Updater")
+        self.storage_patch.start()
+        self.addCleanup(self.storage_patch.stop)
+
+    def _launch(self):
+        return launcher.launch_updater(
+            self.package, current_version="5.13", target_version="5.14",
+            pid=456, install_dir=self.install,
+        )
+
+    def _expected_args(self):
+        return [
+            "--package", str(self.package.resolve()), "--install-dir", str(self.install.resolve()),
+            "--current-version", "5.13", "--target-version", "5.14", "--pid", "456", "--relaunch",
