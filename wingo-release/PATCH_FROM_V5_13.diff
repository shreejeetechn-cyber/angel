+def _process_write(path, index, ready):
+    from app.core.secret_store import ProtectedSecretStore
+    ready.wait(timeout=10)
+    for item in range(2):
+        ProtectedSecretStore(path).set(f"TEST_ACCESS_TOKEN_{index}_{item}", "invented-test-token")
+
+
+def _hold_file_lock(path, ready, release):
+    import os
+    with open(path, "a+b") as handle:
+        if handle.seek(0, os.SEEK_END) == 0:
+            handle.write(b"\0")
+            handle.flush()
+        handle.seek(0)
+        if os.name == "nt":
+            import msvcrt
+            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
+        ready.set()
+        release.wait(timeout=10)
+        handle.seek(0)
+        if os.name == "nt":
+            msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+        else:
+            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
