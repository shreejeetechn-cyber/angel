+def _snapshot_value(value):
+    """Detach JSON-like values without deepcopy's per-scalar dispatch cost.
+
+    Keep the dataclasses.asdict behaviour for nested dataclasses, container
+    subclasses and unusual values. Never truncate history or share mutable
+    containers with a returned persistence/inspector snapshot.
+    """
+    value_type = type(value)
+    if value_type in _SNAPSHOT_ATOMIC_TYPES:
+        return value
+    if value_type is dict:
+        return {_snapshot_value(key): _snapshot_value(item) for key, item in value.items()}
+    if value_type is list:
+        return [_snapshot_value(item) for item in value]
+    if value_type is tuple:
+        return tuple(_snapshot_value(item) for item in value)
+    if is_dataclass(value) and not isinstance(value, type):
+        return asdict(value)
+    if isinstance(value, tuple) and hasattr(value, "_fields"):
+        return value_type(*(_snapshot_value(item) for item in value))
+    if isinstance(value, (tuple, list)):
+        return value_type(_snapshot_value(item) for item in value)
+    if isinstance(value, dict):
+        return value_type((_snapshot_value(key), _snapshot_value(item)) for key, item in value.items())
+    return deepcopy(value)
+
