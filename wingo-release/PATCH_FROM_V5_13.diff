+def _launch_elevated_windows(executable: Path, args: list[str], cwd: Path) -> None:
+    """Start an EXE requiring administrator rights without invoking a shell.
+
+    CreateProcess/Popen fails with Windows error 740 for our requireAdministrator
+    updater. ShellExecuteEx with ``runas`` performs the normal UAC handshake and
+    reports cancellation synchronously, before the caller closes WINGO.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    class ShellExecuteInfo(ctypes.Structure):
+        _fields_ = [
+            ("cbSize", wintypes.DWORD),
+            ("fMask", wintypes.ULONG),
+            ("hwnd", wintypes.HWND),
+            ("lpVerb", wintypes.LPCWSTR),
+            ("lpFile", wintypes.LPCWSTR),
+            ("lpParameters", wintypes.LPCWSTR),
+            ("lpDirectory", wintypes.LPCWSTR),
+            ("nShow", ctypes.c_int),
+            ("hInstApp", wintypes.HINSTANCE),
+            ("lpIDList", ctypes.c_void_p),
+            ("lpClass", wintypes.LPCWSTR),
+            ("hkeyClass", wintypes.HKEY),
+            ("dwHotKey", wintypes.DWORD),
+            ("hIconOrMonitor", wintypes.HANDLE),
+            ("hProcess", wintypes.HANDLE),
+        ]
+
+    shell32 = ctypes.WinDLL("shell32", use_last_error=True)
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    shell_execute = shell32.ShellExecuteExW
+    shell_execute.argtypes = [ctypes.POINTER(ShellExecuteInfo)]
+    shell_execute.restype = wintypes.BOOL
+    close_handle = kernel32.CloseHandle
+    close_handle.argtypes = [wintypes.HANDLE]
+    close_handle.restype = wintypes.BOOL
+
+    info = ShellExecuteInfo()
+    info.cbSize = ctypes.sizeof(info)
+    # Retain the process handle to confirm an EXE was started; wait for shell
+    # launch/UAC completion, but never wait for the updater itself to exit.
+    info.fMask = 0x00000040 | 0x00000100  # NOCLOSEPROCESS | NOASYNC
+    info.lpVerb = "runas"
+    info.lpFile = str(executable)
+    # lpFile is separate from parameters. list2cmdline applies Windows CRT
+    # quoting for spaces, embedded quotes, and trailing backslashes; no cmd.exe.
+    info.lpParameters = subprocess.list2cmdline(args)
+    info.lpDirectory = str(cwd)
+    info.nShow = 1  # SW_SHOWNORMAL
+    if not shell_execute(ctypes.byref(info)):
+        error = ctypes.get_last_error() or 1
+        if error == 1223:  # ERROR_CANCELLED: user rejected the UAC prompt.
+            raise OSError(error, "Windows administrator approval was cancelled; WINGO remains open.")
+        raise ctypes.WinError(error)
+    if not info.hProcess:
+        raise RuntimeError("Windows did not return a process handle for WINGOUpdater; WINGO remains open.")
+    # Closing our handle does not terminate the detached updater. It waits for
+    # WINGO's PID to exit before changing any installed files.
+    close_handle(info.hProcess)
 
 
