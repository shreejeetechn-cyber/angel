+"""Process-wide REST admission and broker cooldowns (no automatic retries).
+
+These are conservative WINGO operator presets, not contractual broker quotas:
+FYERS 45 requests / 60 seconds (below the 50/min observed in the supplied logs),
+UPSTOX 120 / 60 and DHAN 20 / 60. All endpoints and provider instances in this
+process share each broker's sliding window. Separate WINGO processes/accounts
+are not coordinated. Operators must check their own endpoint/account limits.
+
+Environment overrides (read when a broker budget is first used):
+  WINGO_<BROKER>_REST_REQUESTS_PER_WINDOW   positive integer
+  WINGO_<BROKER>_REST_WINDOW_SECONDS       positive seconds
+Calls fail fast by default with RateBudgetExceeded.retry_after_seconds; callers
+must schedule later instead of retrying immediately. Explicit bounded waiting
+is available for workers only, and never permitted on Qt's GUI thread.
+TLS and SDK signature/checksum verification are unchanged.
+"""
+from __future__ import annotations
+
+from collections import deque
+from datetime import datetime, timezone
+from email.utils import parsedate_to_datetime
+import math
+import os
+import sys
+import threading
+import time
+from typing import Callable, TypeVar
+
+T = TypeVar("T")
+_PRESETS = {"FYERS": (45, 60.0), "UPSTOX": (120, 60.0), "DHAN": (20, 60.0)}
+
+
+class RateBudgetExceeded(RuntimeError):
+    """A deferred request, or a provider 429; never an authentication failure."""
+    def __init__(self, broker: str, retry_after_seconds: float, operation: str = "REST", *, remote: bool = False):
+        self.broker = str(broker).upper()
+        self.retry_after_seconds = max(0.0, float(retry_after_seconds))
+        self.remote = bool(remote)
+        self.status_code = 429
+        self.error_kind = "RATE_LIMIT"
+        origin = "broker cooldown" if remote else "shared REST budget"
+        super().__init__(f"{self.broker} {operation}: {origin}; retry after {self.retry_after_seconds:.2f}s")
+
+
+def _is_gui_thread() -> bool:
+    qt = sys.modules.get("PySide6.QtCore")
+    if qt is None:
+        return False
+    try:
+        app = qt.QCoreApplication.instance()
+        return app is not None and qt.QThread.currentThread() == app.thread()
+    except Exception:
+        return False
+
+
+class RequestBudget:
+    def __init__(self, broker: str, limit: int, window_seconds: float, *, clock: Callable[[], float] = time.monotonic, sleeper: Callable[[float], None] = time.sleep):
+        if int(limit) <= 0 or not math.isfinite(float(window_seconds)) or float(window_seconds) <= 0:
+            raise ValueError("REST budget requires a positive limit and finite window")
+        self.broker, self.limit, self.window_seconds = str(broker).upper(), int(limit), float(window_seconds)
+        self._clock, self._sleeper = clock, sleeper
+        self._lock = threading.Lock()
+        self._requests: deque[float] = deque()
+        self._cooldown_until = 0.0
+
+    def acquire(self, *, operation: str = "REST", max_wait_seconds: float = 0.0) -> None:
+        max_wait = max(0.0, float(max_wait_seconds))
+        if not math.isfinite(max_wait):
+            raise ValueError("max_wait_seconds must be finite")
+        if _is_gui_thread():
+            max_wait = 0.0
+        deadline = self._clock() + max_wait
+        while True:
+            with self._lock:
+                now = self._clock()
+                while self._requests and self._requests[0] <= now - self.window_seconds:
+                    self._requests.popleft()
+                delay = max(0.0, self._cooldown_until - now)
+                if len(self._requests) >= self.limit:
+                    delay = max(delay, self._requests[0] + self.window_seconds - now)
+                if delay <= 0:
+                    self._requests.append(now)
+                    return
+                remote = self._cooldown_until > now
+            # Never hold the budget lock while a worker waits.
+            if delay > deadline - now or max_wait <= 0:
+                raise RateBudgetExceeded(self.broker, delay, operation, remote=remote)
+            self._sleeper(delay)
+
+    def cooldown(self, seconds: float | None = None) -> float:
+        delay = self.window_seconds if seconds is None else float(seconds)
+        if not math.isfinite(delay) or delay < 0:
+            delay = self.window_seconds
+        with self._lock:
+            self._cooldown_until = max(self._cooldown_until, self._clock() + delay)
+        return delay
+
+
+_registry: dict[str, RequestBudget] = {}
+_registry_lock = threading.Lock()
+
+
+def get_request_budget(broker: str) -> RequestBudget:
+    name = str(broker).upper()
+    if name not in _PRESETS:
+        raise ValueError(f"Unknown REST broker: {name}")
+    with _registry_lock:
+        if name not in _registry:
+            count, seconds = _PRESETS[name]
+            try:
+                count = int(os.environ.get(f"WINGO_{name}_REST_REQUESTS_PER_WINDOW", str(count)))
+                seconds = float(os.environ.get(f"WINGO_{name}_REST_WINDOW_SECONDS", str(seconds)))
+            except (TypeError, ValueError) as exc:
+                raise ValueError(f"Invalid {name} REST budget environment configuration") from exc
+            _registry[name] = RequestBudget(name, count, seconds)
+        return _registry[name]
+
+
+def _retry_after(headers=None, payload=None) -> float | None:
+    value = None
+    if headers:
+        value = headers.get("Retry-After") or headers.get("retry-after")
+    if value is None and isinstance(payload, dict):
+        value = payload.get("retry_after", payload.get("retryAfter"))
+        if value is None and isinstance(payload.get("headers"), dict):
