+def classify_fyers_startup_error(error: object) -> str:
+    """Keep transient startup failures separate from rejected credentials."""
+    text = str(error or "")
+    lower = text.lower()
+    if isinstance(error, (ImportError, ModuleNotFoundError)) or any(marker in lower for marker in (
+        "fyers package resource missing", "fyers-apiv3", "fyers_apiv3", "map.json",
+    )):
+        return "PACKAGE"
+    kind = classify_auth_error(error)
+    if (kind is AuthErrorKind.RATE_LIMITED or getattr(error, "status_code", None) == 429
+            or getattr(error, "error_kind", None) == "RATE_LIMIT" or any(marker in lower for marker in (
+        "request limit", "too many requests", "rate limit", "http 429",
+    ))):
+        return "RATE"
+    provider_code = getattr(error, "code", None)
+    ws_kind = classify_ws_error(
+        {"code": provider_code, "message": text} if provider_code is not None else error
+    ).get("kind")
+    error_type = type(error).__name__.lower()
+    if (kind is AuthErrorKind.NETWORK_ERROR or ws_kind == "NETWORK"
+            or isinstance(error, (TimeoutError, ConnectionError))
+            or any(marker in error_type for marker in ("timeout", "connectionerror", "nameresolutionerror", "gaierror"))):
+        return "NETWORK"
+    if login_required(kind) or ws_kind == "AUTH" or any(marker in lower for marker in (
+        "auth expired/invalid", "fyers_access_token is missing",
