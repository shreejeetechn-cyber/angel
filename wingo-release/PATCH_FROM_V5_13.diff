+"""Offline regression tests for ordered nonblocking tick spill/replay."""
+from __future__ import annotations
+
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from app.core.live_tick_buffer import LiveTickBuffer
+
+
+def wait_until(predicate, timeout=3.0):
+    deadline = time.monotonic() + timeout
+    while not predicate():
+        if time.monotonic() >= deadline:
+            raise AssertionError("Timed out waiting for spool worker")
+        time.sleep(0.001)
+
+
+class GatedWriteBuffer(LiveTickBuffer):
+    def __init__(self, *args, **kwargs):
+        self.entered = threading.Event()
+        self.release = threading.Event()
+        super().__init__(*args, **kwargs)
+
+    def _write_spill(self, path, rows):
+        self.entered.set()
+        if not self.release.wait(5):
+            raise TimeoutError("Test did not release writer")
+        return super()._write_spill(path, rows)
+
+
+class GatedReadBuffer(LiveTickBuffer):
+    def __init__(self, *args, **kwargs):
+        self.entered = threading.Event()
+        self.release = threading.Event()
+        super().__init__(*args, **kwargs)
+
+    def _read_spill(self, path, count, first_sequence):
+        self.entered.set()
+        if not self.release.wait(5):
+            raise TimeoutError("Test did not release reader")
+        return super()._read_spill(path, count, first_sequence)
+
+
+class TickSpoolTests(unittest.TestCase):
+    def make_buffer(self, cls=LiveTickBuffer):
+        directory = tempfile.TemporaryDirectory()
+        buffer = cls(1000, directory.name)
+
+        def cleanup():
+            if hasattr(buffer, "release"):
+                buffer.release.set()
+            buffer.close(3)
+            buffer.clear()
+            buffer.close(3)
+            directory.cleanup()
+
+        self.addCleanup(cleanup)
+        return buffer
+
+    @staticmethod
+    def fill(buffer, count, offset=0):
+        for i in range(offset, offset + count):
+            assert buffer.push({"provider": "QA", "symbol": f"S{i % 7}",
+                                "sequence": i + 1, "ltp": i})
+
+    def consume(self, buffer, limit=137):
+        result = []
+        deadline = time.monotonic() + 5
+        while buffer.snapshot()["backlog"]:
+            self.assertLess(time.monotonic(), deadline, "drain stalled")
+            batch = buffer.drain(limit)
+            result.extend(batch["raw"])
+            if not batch["raw"]:
+                time.sleep(0.001)
+        return result
+
+    def sequences(self, rows):
+        return [row["ingress_sequence"] for row in rows]
+
+    def assert_responsive(self, fn):
+        # A blocked fake disk remains gated for up to five seconds; an ingress
+        # operation must complete without waiting for that release.
+        done = threading.Event()
+        result = []
+
+        def run():
+            try:
+                result.append(fn())
+            finally:
+                done.set()
+
+        thread = threading.Thread(target=run, daemon=True)
+        thread.start()
+        self.assertTrue(done.wait(0.5), "operation waited for filesystem I/O")
+        thread.join()
+        return result[0]
+
+    def test_memory_lane_and_latest_are_compatible(self):
+        buffer = self.make_buffer()
+        self.fill(buffer, 100)
+        batch = buffer.drain(100)
+        self.assertEqual(self.sequences(batch["raw"]), list(range(1, 101)))
+        self.assertEqual(len(batch["latest"]), 7)
+        self.assertEqual(batch["backlog"], 0)
+        self.assertEqual(batch["sequence_gaps"], 0)
+        self.assertFalse(buffer.push(None))
+
+    def test_completed_disk_chunks_replay_in_order(self):
+        buffer = self.make_buffer()
+        self.fill(buffer, 2500)
+        wait_until(lambda: not buffer._io_running)
+        self.assertGreater(buffer.snapshot()["spill_written_total"], 0)
+        self.assertGreater(buffer.snapshot()["spill_files"], 0)
+        rows = self.consume(buffer)
+        self.assertEqual(self.sequences(rows), list(range(1, 2501)))
+        self.assertEqual(buffer.snapshot()["dropped"], 0)
+        wait_until(lambda: not buffer._io_running)
+        self.assertEqual(list(buffer._spill_dir.glob("*.jsonl")), [])
+
+    def test_slow_write_does_not_block_ingress_drain_or_snapshot(self):
+        buffer = self.make_buffer(GatedWriteBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        self.assert_responsive(lambda: buffer.push({"symbol": "EXTRA"}))
+        self.assertEqual(self.assert_responsive(buffer.snapshot)["backlog"], 1301)
+        first = self.assert_responsive(lambda: buffer.drain(137))["raw"]
+        self.assertEqual(self.sequences(first), list(range(1, 138)))
+        buffer.release.set()
+        rows = first + self.consume(buffer)
+        self.assertEqual(self.sequences(rows), list(range(1, 1302)))
+        self.assertEqual(buffer.snapshot()["dropped"], 0)
+
+    def test_pending_read_returns_partial_batch_and_preserves_order(self):
+        buffer = self.make_buffer(GatedReadBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        batch = self.assert_responsive(lambda: buffer.drain(1000))
+        self.assertEqual(batch["raw"], [])
+        self.assertEqual(batch["backlog"], 1300)
+        self.assert_responsive(lambda: buffer.push({"symbol": "EXTRA"}))
+        buffer.release.set()
+        rows = self.consume(buffer)
+        self.assertEqual(self.sequences(rows), list(range(1, 1302)))
+
+    def test_requeue_precedes_spill_ram_and_concurrent_write(self):
+        buffer = self.make_buffer(GatedWriteBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        original = buffer.drain(137)["raw"]
+        self.assertEqual(buffer.requeue_front(original), 137)
+        repeated = buffer.drain(137)["raw"]
+        self.assertEqual(repeated, original)
+        buffer.release.set()
+        self.assertEqual(self.sequences(repeated + self.consume(buffer)),
+                         list(range(1, 1301)))
+        self.assertEqual(buffer.snapshot()["received"], 1300)
+
+    def test_partial_queued_chunk_uses_remaining_sequence_for_disk_replay(self):
+        buffer = self.make_buffer(GatedWriteBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        # First chunk is being written; consume that entire chunk and a prefix
+        # of the next queued chunk before the worker can claim its suffix.
+        first = buffer.drain(400)["raw"]
+        self.assertEqual(self.sequences(first), list(range(1, 401)))
+        buffer.release.set()
+        wait_until(lambda: not buffer._io_running)
+        self.assertEqual(self.sequences(first + self.consume(buffer)),
+                         list(range(1, 1301)))
+        self.assertEqual(buffer.snapshot()["dropped"], 0)
+
+    def test_write_failure_retains_original_rows_without_drop(self):
+        class FailedWrite(LiveTickBuffer):
+            def _write_spill(self, path, rows):
+                raise OSError("Synthetic disk full")
+
+        buffer = self.make_buffer(FailedWrite)
+        self.fill(buffer, 1300)
+        wait_until(lambda: not buffer._io_running)
+        self.assertGreater(buffer.snapshot()["spill_failures"], 0)
+        self.assertEqual(self.sequences(self.consume(buffer)), list(range(1, 1301)))
+        self.assertEqual(buffer.snapshot()["dropped"], 0)
+
+    def test_corrupt_or_truncated_read_accounts_for_every_lost_tick(self):
+        class CorruptSpill(LiveTickBuffer):
+            def _write_spill(self, path, rows):
+                path.write_text("[1, {}]\\n", encoding="utf-8")
+
+        buffer = self.make_buffer(CorruptSpill)
+        self.fill(buffer, 1300)
+        wait_until(lambda: not buffer._io_running)
+        rows = self.consume(buffer)
+        snapshot = buffer.snapshot()
+        self.assertEqual(len(rows) + snapshot["dropped"], 1300)
+        self.assertGreater(snapshot["spill_failures"], 0)
+        self.assertEqual(self.sequences(rows), sorted(set(self.sequences(rows))))
+
+    def test_generation_fences_inflight_write_and_stale_requeue(self):
+        buffer = self.make_buffer(GatedWriteBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        old = buffer.drain(10)["raw"]
+        self.assertEqual(self.assert_responsive(buffer.bump_generation), 1)
+        self.assertEqual(buffer.requeue_front(old), 0)
+        self.fill(buffer, 3, offset=1300)
+        buffer.release.set()
+        rows = self.consume(buffer)
+        self.assertEqual(self.sequences(rows), [1301, 1302, 1303])
+        self.assertTrue(all(row["exchange_generation"] == 1 for row in rows))
+        self.assertEqual(buffer.snapshot()["sequence_gaps"], 0)
+        wait_until(lambda: not buffer._io_running)
+        self.assertEqual(list(buffer._spill_dir.glob("*.jsonl")), [])
+
+    def test_same_generation_clear_fences_inflight_read(self):
+        buffer = self.make_buffer(GatedReadBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        self.assert_responsive(buffer.clear)
+        self.assertEqual(buffer.generation(), 0)
+        self.fill(buffer, 3, offset=1300)
+        buffer.release.set()
+        rows = self.consume(buffer)
+        self.assertEqual(self.sequences(rows), [1301, 1302, 1303])
+        wait_until(lambda: not buffer._io_running)
+        self.assertEqual(buffer.snapshot()["dropped"], 0)
+
+    def test_instances_share_directory_without_path_collision_or_deletion(self):
+        a = self.make_buffer()
+        b = LiveTickBuffer(1000, a._spill_dir)
+        self.addCleanup(lambda: (b.clear(), b.close(3)))
+        self.fill(a, 1300)
+        self.fill(b, 1300)
+        wait_until(lambda: not a._io_running and not b._io_running)
+        a.clear()
+        a.close(3)
+        self.assertEqual(self.sequences(self.consume(b)), list(range(1, 1301)))
+        self.assertEqual(b.snapshot()["dropped"], 0)
+
+    def test_close_has_bounded_wait_rejects_push_and_preserves_backlog(self):
+        buffer = self.make_buffer(GatedWriteBuffer)
+        self.fill(buffer, 1300)
+        self.assertTrue(buffer.entered.wait(2))
+        self.assertFalse(self.assert_responsive(lambda: buffer.close(0.01)))
+        self.assertFalse(buffer.push({"symbol": "AFTER_CLOSE"}))
+        self.assertEqual(buffer.snapshot()["backlog"], 1300)
+        buffer.release.set()
+        self.assertTrue(buffer.close(3))
+        self.assertEqual(self.sequences(self.consume(buffer)), list(range(1, 1301)))
+
+    def test_parallel_producers_and_consumer_deliver_every_tick_once(self):
+        buffer = self.make_buffer()
+        done = threading.Event()
+        result = []
+
+        def producer(provider):
+            for i in range(1800):
+                buffer.push({"provider": provider, "symbol": "X", "sequence": i + 1})
+
+        def consumer():
+            while not done.is_set() or buffer.snapshot()["backlog"]:
+                result.extend(buffer.drain(71)["raw"])
+                time.sleep(0.0001)
+
+        producers = [threading.Thread(target=producer, args=(str(i),)) for i in range(3)]
+        consumer_thread = threading.Thread(target=consumer, daemon=True)
+        consumer_thread.start()
+        for thread in producers:
+            thread.start()
+        for thread in producers:
+            thread.join(3)
+            self.assertFalse(thread.is_alive())
+        done.set()
+        consumer_thread.join(5)
+        self.assertFalse(consumer_thread.is_alive())
+        self.assertEqual(self.sequences(result), list(range(1, 5401)))
+        self.assertEqual(buffer.snapshot()["dropped"], 0)
+        self.assertEqual(buffer.snapshot()["sequence_gaps"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
