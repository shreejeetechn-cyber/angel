+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from app.core.symbol_validation import filter_fyers_symbols
+from app.providers.auth_error import AuthErrorKind, classify_auth_error, login_required
+
+
+class Clock:
+    def __init__(self):
+        self.now = 100.0
+
+    def monotonic(self):
+        return self.now
+
+    def time(self):
+        return self.now
+
+
+class Emitter:
+    def __init__(self):
+        self.events = []
+
+    def emit(self, value):
+        self.events.append(value)
+
+
+class FakeSignal:
+    def __init__(self, *_args):
+        self.name = None
+
+    def __set_name__(self, owner, name):
+        self.name = '_signal_' + name
+
+    def __get__(self, obj, owner):
+        if obj is None:
+            return self
+        return obj.__dict__.setdefault(self.name, Emitter())
+
+
+def load_feed(filename, class_name, clock):
+    """Compile the unchanged functions/classes with controlled dependencies."""
+    class FakeQThread:
+        def __init__(self):
+            self.interrupted = False
+
+        def isInterruptionRequested(self):
+            return self.interrupted
+
+        def requestInterruption(self):
+            self.interrupted = True
+
+        def msleep(self, milliseconds):
+            clock.now += milliseconds / 1000.0
+
+    source = ast.parse((ROOT / 'app/providers' / filename).read_text(encoding='utf-8'))
+    definitions = [node for node in source.body if isinstance(node, (ast.FunctionDef, ast.ClassDef))]
+    module = ast.Module(body=[ast.ImportFrom(module='__future__', names=[ast.alias(name='annotations')], level=0), *definitions], type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = {
+        'QThread': FakeQThread, 'Signal': FakeSignal, 'time': clock,
+        'threading': threading, 'base64': base64, 'json': json,
+        'FYERS_AUTH_ERROR_CODES': {-8, -15, -16, -17, 401},
+        'filter_fyers_symbols': filter_fyers_symbols,
+        'AuthErrorKind': AuthErrorKind, 'classify_auth_error': classify_auth_error,
+        'login_required': login_required,
+    }
+    exec(compile(module, filename, 'exec'), namespace)
+    return namespace[class_name], namespace
+
+
+class Mapper:
+    rows = [object()]
+
+    def map_many(self, desired):
+        return {symbol: symbol for symbol in desired}, {}
+
+
+class UpstoxSubscriptions(unittest.TestCase):
+    def setUp(self):
+        self.clock = Clock()
+        feed_class, self.ns = load_feed('upstox_live.py', 'UpstoxLiveFeed', self.clock)
+        self.feed = feed_class(['A'], Mapper())
+        self.feed._connected = True
+        self.calls = []
+        self.on_subscribe = lambda: None
+
+        def subscribe(keys, mode):
+            self.calls.append(('subscribe', list(keys), mode))
+            self.on_subscribe()
