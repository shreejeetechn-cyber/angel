+        self.assertEqual(self.feed._active_keys, ['A'])
+        self.on_subscribe = lambda: None
+        self.feed._apply_sync()
+        self.assertEqual(self.feed._active_keys, ['B'])
+        self.assertFalse(self.feed._dirty)
+        self.assertEqual(self.calls[-1], ('subscribe', ['B'], 'full'))
