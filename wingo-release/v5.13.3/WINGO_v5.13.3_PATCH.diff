+class SnapshotTests(unittest.TestCase):
+    def test_snapshot_matches_asdict_and_is_detached(self):
+        rec = record(1)
+        rec.state_history = [{"at": str(i), "state": "ACTIVE", "nested": {"values": [i]}} for i in range(64)]
+        rec.runtime_only = {"not": "a dataclass field"}
+        expected = asdict(rec)
+        snapshot = rec.to_dict()
+        self.assertEqual(snapshot, expected)
+        self.assertNotIn("runtime_only", snapshot)
+        self.assertEqual(len(snapshot["state_history"]), 64)
+        snapshot["legs"][0]["depth"]["bid"][0][0] = -1
+        snapshot["state_history"][0]["nested"]["values"].append(99)
+        snapshot["selection_alternatives"][0]["reasons"].append("changed")
+        snapshot["breakeven"][1]["scenario"].append(9)
+        self.assertEqual(rec.to_dict(), expected)
+        rec.legs[0]["depth"]["ask"][0][0] = 22
+        self.assertEqual(snapshot["legs"][0]["depth"]["ask"][0][0], 10)
+
+    def test_subclasses_any_fields_and_unusual_values_keep_asdict_semantics(self):
+        @dataclass
+        class Nested:
+            values: list
+
+        @dataclass
+        class Extended(SignalRecord):
+            extra: object = None
+
+        pair = namedtuple("Pair", "data")
+        rec = Extended(**record(2).to_dict(), extra=pair(Nested([1, {"value": [2]}])))
+        rec.expiry = Nested(["2026-10-29"])
+        self.assertEqual(rec.to_dict(), asdict(rec))
+
+    def test_7200_complete_snapshots_profile(self):
+        rows = [record(i) for i in range(7200)]
+        measured = {}
+        for label, serialize in (("asdict", asdict), ("detached", lambda rec: rec.to_dict())):
+            started = time.perf_counter()
+            total = 0
+            for rec in rows:
+                snapshot = serialize(rec)
+                self.assertEqual(snapshot["signal_id"], rec.signal_id)
+                total += len(snapshot["state_history"])
+            measured[label] = time.perf_counter() - started
+            self.assertEqual(total, 7200 * 8)
+        print(f"7200 complete snapshots: asdict={measured['asdict']:.3f}s detached={measured['detached']:.3f}s")
+
