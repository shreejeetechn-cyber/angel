+        ui.signals_table.resize(900, 500)
+        ui.signals_table.show()
+        heartbeats = []
+        timer = QTimer()
+        timer.setInterval(0)
+        timer.timeout.connect(lambda: heartbeats.append(time.monotonic()))
+        timer.start()
+        started = time.monotonic()
+        ui._begin_signals_table_refresh()
+        deadline = time.monotonic() + 10
+        while ui._signals_refresh_running and time.monotonic() < deadline:
+            app.processEvents()
+        timer.stop()
+        self.assertFalse(ui._signals_refresh_running, "bounded refresh failed to complete")
+        self.assertEqual(ui.signals_table.rowCount(), 154)
+        self.assertEqual(ui.details_calls, 1)
+        self.assertGreater(len(heartbeats), 50)
+        elapsed = time.monotonic() - started
+        gaps = [b - a for a, b in zip(heartbeats, heartbeats[1:])]
+        self.assertLess(max(gaps), 0.25, "GUI heartbeat delayed more than 250ms during this isolated refresh")
+        self.assertLess(elapsed, 5.0, "isolated 154-row refresh exceeded five seconds")
