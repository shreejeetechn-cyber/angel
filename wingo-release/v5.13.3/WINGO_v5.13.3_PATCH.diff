+def production_harness(*, gui=False):
+    """Compile production methods unchanged, replacing only external services."""
+    tree = ast.parse((ROOT / "app/ui/main_window.py").read_text(encoding="utf-8"))
+    window = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "MainWindow")
+    selected = [node for node in window.body if isinstance(node, ast.FunctionDef) and node.name in METHODS]
+    namespace = dict(time=time, render_bounded_chunk=render_bounded_chunk,
+                     QTimer=TimerQueue, QSignalBlocker=Blocker, urlparse=urlparse, parse_qs=parse_qs,
+                     datetime=datetime, contracts_display=contracts_display, contract_lock_id=contract_lock_id,
+                     legs_tooltip=legs_tooltip, expiry_label=expiry_label, quote_age_seconds=quote_age_seconds,
+                     signal_quote_fresh=signal_quote_fresh, PAPER_QUOTE_MAX_AGE_SECONDS=PAPER_QUOTE_MAX_AGE_SECONDS,
+                     Qt=SimpleNamespace(DescendingOrder=1, AscendingOrder=0, DisplayRole=0))
+    if gui:
+        from PySide6.QtCore import QSignalBlocker, QTimer, Qt
+        from PySide6.QtGui import QColor
+        from PySide6.QtWidgets import QTableWidgetItem
+        from app.ui.theme_presets import DEFAULT_THEME_ID, theme_palette
+        namespace.update(QTimer=QTimer, QSignalBlocker=QSignalBlocker, Qt=Qt, QColor=QColor,
+                         QTableWidgetItem=QTableWidgetItem, THEME=theme_palette(DEFAULT_THEME_ID))
+    cls = ast.ClassDef(name="Harness", bases=[], keywords=[], body=selected, decorator_list=[])
+    module = ast.fix_missing_locations(ast.Module(body=[cls], type_ignores=[]))
+    exec(compile(module, str(ROOT / "app/ui/main_window.py"), "exec"), namespace)
+    return namespace["Harness"], namespace
