+        self.addCleanup(self.stack.close)
+        self.root = Path(self.stack.enter_context(tempfile.TemporaryDirectory(prefix="wingo-auth-qa-")))
+        self.stack.enter_context(patch.dict(os.environ, {
+            "WINGO_ENV_MODE": "ISOLATED",
+            "WINGO_ENV_FILE": str(self.root / "config" / ".env"),
+            "WINGO_DATA_ROOT": str(self.root / "runtime"),
+            "WINGO_INSTALL_MODE": "0",
+        }))
+        from app.core import config, migration, secret_store
+        self.config, self.migration, self.secrets = config, migration, secret_store
+        self.stack.enter_context(patch.object(config, "COMMON_ENV", self.root / "config" / ".env"))
+        self.stack.enter_context(patch.object(config, "_LAST_DOTENV_KEYS", set()))
+        self.stack.enter_context(patch.object(config, "_LAST_ENV_SIGNATURE", None))
+        self.stack.enter_context(patch.object(config, "_LAST_ENV_CHECK_MONO", 0.0))
+        config.get_settings.cache_clear()
+        self.addCleanup(config.get_settings.cache_clear)
