+        self.assertEqual(ui._selected_signal().signal_id, "SIG-0")
+        print(f"Qt 7215/154: {elapsed:.3f}s; heartbeat max gap={max(gaps) * 1000:.1f}ms")
+        ui.signals_table.deleteLater()
+        app.processEvents()
