+class SecretStoreTests(IsolatedTest):
+    def test_concurrent_thread_writers_preserve_all_keys(self):
+        path = self.root / "secrets.dat"
+        def write(index):
+            self.secrets.ProtectedSecretStore(path).set(f"TEST_ACCESS_TOKEN_{index}", "invented-token")
