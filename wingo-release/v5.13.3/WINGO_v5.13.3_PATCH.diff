+"""Offline Dhan account validation/save/renewal checks; no broker I/O."""
+from __future__ import annotations
+
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import ExitStack
+import json
+import io
+import logging
+import os
+from pathlib import Path
+import sys
+import tempfile
+import time
+import traceback
+import types
+import unittest
+from unittest.mock import Mock, patch
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+
+class DhanAuthTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.context = ExitStack()
+        root = Path(cls.context.enter_context(tempfile.TemporaryDirectory(prefix="wingo-dhan-auth-qa-")))
+        cls.context.enter_context(patch.dict(os.environ, {
+            "WINGO_ENV_MODE": "ISOLATED",
+            "WINGO_ENV_FILE": str(root / "missing.env"),
+            "WINGO_STATE_ROOT": str(root / "state"),
+        }))
+        import requests
+        cls.context.enter_context(patch.object(
+            requests.sessions.Session, "request",
+            side_effect=AssertionError("Dhan offline test attempted remote HTTP"),
+        ))
+        from app.providers import auth_manager
+        cls.auth = auth_manager
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.context.close()
+
+    def setUp(self):
+        self.stack = ExitStack()
+        self.addCleanup(self.stack.close)
+        self.settings = types.SimpleNamespace(
+            dhan_client_id="TESTCLIENT", dhan_access_token="invented-old-token",
+            dhan_token_expiry="2026-01-01T00:00:00",
+        )
+        self.events = []
+        self.saved = []
+        self.profile = {"dhanClientId": "TESTCLIENT", "tokenValidity": "20/10/2026 09:30"}
+        self.renewal = {"accessToken": "invented-new-token", "dhanClientId": "TESTCLIENT"}
+        self.generation = {"accessToken": "invented-generated-token", "dhanClientId": "TESTCLIENT"}
+        self.http_error = None
+        self.json_error = None
+        self.post_error = None
+        self.budget_calls = []
+        self.manager = self.auth.AuthManager()
+        self.manager._settings = lambda: self.settings
+        self.manager.session = types.SimpleNamespace(
+            get=Mock(side_effect=self._get), post=Mock(side_effect=self._post),
+        )
+        self.stack.enter_context(patch.object(self.auth, "save_common_env_value", side_effect=self._save))
+        self.stack.enter_context(patch.object(self.auth, "call_with_budget", side_effect=self._budget))
+
+    def _save(self, key, value):
+        self.events.append("save:" + key)
+        self.saved.append((key, value))
+
+    def _budget(self, broker, request, **kwargs):
+        self.budget_calls.append((broker, kwargs))
+        return request()
+
+    def _get(self, url, **kwargs):
+        if url == self.auth.AuthManager.DHAN_PROFILE_URL:
+            self.events.append("profile")
+            payload = self.profile
+        elif url == self.auth.AuthManager.DHAN_RENEW_URL:
+            self.events.append("renew")
+            payload = self.renewal
+        else:
+            raise AssertionError("Unexpected mocked endpoint")
+        return self._response(payload)
+
+    def _post(self, url, **kwargs):
+        if url != self.auth.AuthManager.DHAN_GENERATE_URL:
+            raise AssertionError("Unexpected mocked endpoint")
+        self.events.append("generate")
+        if self.post_error is not None:
+            raise self.post_error
+        return self._response(self.generation)
+
+    def _response(self, payload):
+        def raise_for_status():
+            if self.http_error is not None:
+                raise self.http_error
+        def decode_json():
+            if self.json_error is not None:
+                raise self.json_error
+            return payload
+        return types.SimpleNamespace(raise_for_status=raise_for_status, json=decode_json)
+
+    def assert_no_writes(self):
+        self.assertEqual(self.saved, [])
+
+    def test_profile_request_uses_token_header_budget_and_finite_timeouts(self):
+        result = self.manager.validate_dhan_access_token()
+        self.assertTrue(result["validated"])
+        self.assertEqual(result["expiry_time"], "20/10/2026 09:30")
+        self.manager.session.get.assert_called_once_with(
+            self.manager.DHAN_PROFILE_URL,
+            headers={"access-token": "invented-old-token"}, timeout=(5, 20),
+        )
+        self.assertEqual(self.budget_calls, [("DHAN", {"operation": "Dhan profile authentication"})])
+        self.assert_no_writes()
+
+    def test_explicit_candidate_overrides_saved_credentials(self):
+        self.profile = {"dhanClientId": "NEWCLIENT"}
+        result = self.manager.validate_dhan_access_token(" NEWCLIENT ", " invented-candidate-token ")
+        self.assertEqual(result["client_id"], "NEWCLIENT")
+        self.assertEqual(self.manager.session.get.call_args.kwargs["headers"], {"access-token": "invented-candidate-token"})
+        self.assert_no_writes()
+
+    def test_missing_or_explicitly_blank_fields_never_use_saved_token(self):
+        for client_id, token in (("", "invented-token"), ("TESTCLIENT", ""), (" ", " "), (123, "invented-token"), ("TESTCLIENT", object())):
+            with self.subTest(client_id_type=type(client_id).__name__):
