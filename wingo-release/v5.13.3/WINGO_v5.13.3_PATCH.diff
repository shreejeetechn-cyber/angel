+"""Run the current release gates with isolated state and preserve exit status."""
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+BASELINE = (
+    "verify_signal_catalog_fixpack_20261019.py",
+    "verify_v5_13_startup_dependency_regression.py",
+    "verify_v5_13_canonical_regression.py",
+    "verify_v5_13_auto_update_client.py",
+    "verify_v5_10_multi_feed_relogin_hardening.py",
+    "verify_v5_00_rc_dev3_inline_auth_integration.py",
+    "verify_v5_10_architecture.py",
+    "verify_v5_08_stress_soak.py",
+    "verify_commercial_security.py",
+    "verify_commercial_packaging_tools.py",
+)
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--report", type=Path, default=ROOT / "reports" / "FIXPACK_VALIDATION.json")
+    args = parser.parse_args(argv)
+    report = args.report.resolve()
+    report.parent.mkdir(parents=True, exist_ok=True)
+    log_root = report.parent / "fixpack-test-logs"
+    log_root.mkdir(parents=True, exist_ok=True)
+    results = []
+    syntax_files = list((ROOT / "app").rglob("*.py"))
+    for path in syntax_files:
+        ast.parse(path.read_text(encoding="utf-8-sig"), filename=str(path))
+    tests = sorted(path.name for path in (ROOT / "qa").glob("verify_fixpack_*.py"))
+    if len(tests) < 9:
+        raise RuntimeError("Expected all fixpack regression suites; missing test files")
+    tests.extend(BASELINE)
+    with tempfile.TemporaryDirectory(prefix="wingo-fixpack-gates-") as temporary:
+        for index, name in enumerate(tests):
+            script = ROOT / "qa" / name
+            if not script.is_file():
+                raise FileNotFoundError(script)
+            state = Path(temporary) / str(index)
+            state.mkdir()
+            child_env = dict(os.environ)
+            # Keep process environment and real user credentials unchanged.
+            for key in tuple(child_env):
+                if key.startswith(("FYERS_", "UPSTOX_", "DHAN_")):
+                    child_env.pop(key)
+            child_env.update({
+                "PYTHONDONTWRITEBYTECODE": "1",
+                "PYTHONIOENCODING": "utf-8",
+                "WINGO_SAFE_START": "1",
+                "WINGO_AUTO_RUN": "0",
+                "WINGO_ENV_MODE": "ISOLATED",
+                "WINGO_ENV_FILE": str(state / "missing.env"),
+                "WINGO_STATE_ROOT": str(state / "state"),
+                "XDG_CACHE_HOME": str(state / "cache"),
+            })
+            if sys.platform.startswith("linux") and not child_env.get("DISPLAY"):
+                child_env["QT_QPA_PLATFORM"] = "offscreen"
+            start = time.perf_counter()
+            command = [sys.executable, "-B", str(script)]
+            if name == "verify_signal_catalog_fixpack_20261019.py":
+                command.append("--gui")
+            try:
+                completed = subprocess.run(
+                    command, cwd=ROOT, env=child_env,
+                    capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=180,
+                )
+                output = completed.stdout + completed.stderr
+                code = completed.returncode
+            except subprocess.TimeoutExpired as exc:
+                output = "TIMEOUT: selected suite exceeded 180 seconds\n"
+                for part in (exc.stdout, exc.stderr):
+                    if part:
+                        output += part.decode("utf-8", errors="replace") if isinstance(part, bytes) else part
+                code = 124
+            log_path = log_root / (script.stem + ".log")
+            log_path.write_text(output, encoding="utf-8")
+            elapsed = round(time.perf_counter() - start, 3)
+            result = {"suite": name, "status": "PASS" if code == 0 else "FAIL", "exit_code": code,
+                      "elapsed_seconds": elapsed, "log": str(log_path.relative_to(report.parent))}
+            results.append(result)
+            print(f"{result['status']}: {name} ({elapsed}s)", flush=True)
+            if code:
+                print("\n".join(output.splitlines()[-18:]), flush=True)
+            report.write_text(json.dumps({
+                "source_version": (ROOT / "VERSION.txt").read_text().strip(),
+                "release_version": (ROOT / "VERSION.txt").read_text().strip(), "python": sys.version.split()[0], "platform": sys.platform,
+                "syntax_files": len(syntax_files), "suites": results,
+                "status": "PASS" if all(item["exit_code"] == 0 for item in results) else "FAIL",
+                "native_windows_build": "NOT_RUN", "live_broker_validation": "NOT_RUN",
+            }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    return 0 if results and all(item["exit_code"] == 0 for item in results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
