+name: Build WINGO Windows Fixpack
+
+on:
+  workflow_dispatch:
+    inputs:
+      license_public_key_base64:
+        description: Base64 of the Ed25519 license PUBLIC PEM (never a private key)
+        required: true
+        type: string
+      license_server_url:
+        description: Production HTTPS license-server URL
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  windows:
+    runs-on: windows-latest
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@v4
+      - name: Read release version
+        id: version
+        shell: pwsh
+        run: |
+          $version = (Get-Content -LiteralPath '.\VERSION.txt' -Raw).Trim()
+          if ($version -notmatch '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$') { throw 'VERSION.txt must contain major.minor.patch.' }
+          "version=$version" >> $env:GITHUB_OUTPUT
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          architecture: x64
+      - name: Install Inno Setup
+        shell: pwsh
+        run: choco install innosetup --yes --no-progress
+      - name: Validate public input and build
+        shell: pwsh
+        env:
+          LICENSE_PUBLIC_KEY_BASE64: ${{ inputs.license_public_key_base64 }}
+          LICENSE_SERVER_URL: ${{ inputs.license_server_url }}
+          RELEASE_VERSION: ${{ steps.version.outputs.version }}
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $uri = [Uri]$env:LICENSE_SERVER_URL
+          if (-not $uri.IsAbsoluteUri -or $uri.Scheme -ne 'https') { throw 'An absolute HTTPS license-server URL is required.' }
+          $keyPath = Join-Path $env:RUNNER_TEMP 'wingo-license-public.pem'
+          $keyBytes = [Convert]::FromBase64String($env:LICENSE_PUBLIC_KEY_BASE64)
+          $keyText = [Text.Encoding]::UTF8.GetString($keyBytes)
+          if ($keyText -match 'PRIVATE KEY') { throw 'A private key must never be supplied to this workflow.' }
+          [IO.File]::WriteAllBytes($keyPath, $keyBytes)
+          & .\packaging\BUILD_WINDOWS_COMMERCIAL.ps1 -PythonLauncher python -LicensePublicKey $keyPath -LicenseServerUrl $env:LICENSE_SERVER_URL -DistributionVersion $env:RELEASE_VERSION
+          if ($LASTEXITCODE -ne 0) { throw "Windows build failed ($LASTEXITCODE)" }
+      - name: Upload complete installer, portable runtime and updater
+        uses: actions/upload-artifact@v4
+        with:
+          name: WINGO-v${{ steps.version.outputs.version }}-windows
+          if-no-files-found: error
+          path: .commercial_build/out/*
+      - name: Upload build and QA reports
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: WINGO-v${{ steps.version.outputs.version }}-reports
+          if-no-files-found: ignore
+          path: .commercial_build/reports/*
