+class Blocker:
+    def __init__(self, table):
+        self.table = table
+        self.old = table.blocked
+        table.blocked = True
+
+    def __del__(self):
+        self.table.blocked = self.old
+
+
+class Item:
+    def __init__(self, value):
+        self.value = str(value)
+
+    def text(self):
+        return self.value
+
+
+class Table:
+    def __init__(self):
+        self.rows = 0
+        self.items = {}
+        self.hidden = set()
+        self.current = -1
+        self.blocked = False
+
+    def rowCount(self): return self.rows
+    def columnCount(self): return 29
+    def currentRow(self): return self.current
+    def item(self, row, col): return self.items.get((row, col))
+    def isRowHidden(self, row): return row in self.hidden
+    def setRowCount(self, count): self.rows = count
+    def setSortingEnabled(self, _value): pass
+    def setUpdatesEnabled(self, _value): pass
+    def setColumnHidden(self, _column, _value): pass
+    def viewport(self): return self
+    def update(self): pass
+    def selectRow(self, row): self.current = row
+
+    def setRowHidden(self, row, hidden):
+        self.hidden.add(row) if hidden else self.hidden.discard(row)
