+"""Offline feed regressions using production AST definitions and fake Qt/SDKs.
+
+No credentials, native transport, sockets, timers or broker requests are used.
+Run with: python qa/verify_fixpack_live_subscriptions.py
+"""
+from __future__ import annotations
