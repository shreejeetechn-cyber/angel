+class Clock:
+    def __init__(self):
+        self.now = 0.0
+        self.sleeps = []
+    def __call__(self):
+        return self.now
+    def sleep(self, seconds):
+        self.sleeps.append(seconds)
+        self.now += seconds
+
+
+class Response:
+    def __init__(self, status=200, payload=None, headers=None):
+        self.status_code, self.payload, self.headers = status, payload or {"status": "success", "data": {}}, headers or {}
+        self.ok, self.text, self.reason = status < 400, "", ""
+        self.closed = False
+    def __enter__(self):
+        return self
+    def __exit__(self, *args):
+        self.close()
+    def json(self):
+        return self.payload
+    def close(self):
+        self.closed = True
+    def raise_for_status(self):
+        if not self.ok:
+            raise RuntimeError(f"HTTP {self.status_code}")
+
