+    def test_exchange_switch_fences_every_old_callback_before_policy_or_index_commit(self):
+        old_engine = catalog()
+        new_engine = catalog(3, 1)
+        for rec in new_engine._signals.values():
+            rec.signal_id = "NEW-" + rec.signal_id
+            rec.option_symbol = "MCX:" + rec.signal_id
+            rec.legs = [{"symbol": rec.option_symbol}]
+        new_engine._touch()
+        ui, _ = prepare_harness(old_engine)
+        ui.active_exchange = "NSE"
+        generation = {"value": 1}
+        ui.live_tick_buffer = SimpleNamespace(generation=lambda: generation["value"])
+        policy_records = []
+        ui.session_policy.apply_to_signal = lambda rec: policy_records.append(rec)
+        ui._begin_signals_table_refresh()
+        while not ui._signals_render_state["catalog_row"]:
+            TimerQueue.pending.popleft()()
+        old_state = ui._signals_render_state
+        self.assertEqual(old_state["catalog_row"], 128)
+        before_switch = len(policy_records)
+        new_record = next(iter(new_engine._signals.values()))
+        correct_new_index = {new_record.option_symbol: [new_record]}
+        ui.signal_engine = new_engine
+        ui.active_exchange = "MCX"
+        generation["value"] += 1
+        ui._signal_live_index = correct_new_index
+        callbacks = (ui._render_signals_table_chunk, ui._prepare_signals_catalog_chunk,
+                     ui._finish_signals_table_refresh, ui._finish_signals_filter_chunk,
+                     ui._complete_signals_table_refresh)
+        for callback in callbacks:
+            callback(old_state)
+        self.assertIs(ui._signal_live_index, correct_new_index)
+        self.assertEqual(len(policy_records), before_switch)
+        self.assertEqual(ui.details_calls, 0)
+        # Run through the queued old callback and requeue, then prove old work
+        # cannot cancel a new render that now owns the shared render state.
+        while not ui._signals_render_state:
+            TimerQueue.pending.popleft()()
+        new_state = ui._signals_render_state
+        for callback in callbacks:
+            callback(old_state)
+        self.assertIs(ui._signals_render_state, new_state)
+        while TimerQueue.pending:
+            TimerQueue.pending.popleft()()
+        self.assertFalse(ui._signals_refresh_running)
+        self.assertEqual(ui.details_calls, 1)
+        self.assertEqual(ui.signals_table.rowCount(), 1)
+        self.assertIs(ui._signal_live_index[new_record.option_symbol][0], new_record)
+        self.assertTrue(all(any(rec is new for new in new_engine._signals.values()) for rec in policy_records[before_switch:]))
+
