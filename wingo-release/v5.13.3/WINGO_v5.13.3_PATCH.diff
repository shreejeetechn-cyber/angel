+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix="wingo-dhan-gui-") as temporary, ExitStack() as stack:
+        root = Path(temporary)
+        environment = {k: v for k, v in os.environ.items() if not k.startswith(("FYERS_", "UPSTOX_", "DHAN_"))}
+        environment.update({
+            "WINGO_SAFE_START": "1", "WINGO_AUTO_RUN": "0",
+            "WINGO_ENV_MODE": "ISOLATED",
+            "WINGO_ENV_FILE": str(root / "test.env"), "WINGO_STATE_ROOT": str(root / "state"),
+            "XDG_CACHE_HOME": str(root / "cache"),
+        })
+        if sys.platform.startswith("linux") and not environment.get("DISPLAY"):
+            environment["QT_QPA_PLATFORM"] = "offscreen"
+        stack.enter_context(patch.dict(os.environ, environment, clear=True))
+        import requests
+        stack.enter_context(patch.object(requests.sessions.Session, "request", side_effect=AssertionError("Real broker HTTP is forbidden in Dhan GUI QA")))
+        from PySide6.QtCore import QTimer
+        from PySide6.QtWidgets import QApplication, QLineEdit
+        from app.core.config import refresh_settings
+        from app.core.runtime import shared_env_path
+        from app.ui.main_window import MainWindow
+        from app.ui.web_mirror import build_gui_mirror_snapshot, is_sensitive_widget
+        app = QApplication.instance() or QApplication([])
+        window = MainWindow()
+
+        def pump_until(condition, timeout=5):
+            deadline = time.monotonic() + timeout
+            while not condition() and time.monotonic() < deadline:
+                app.processEvents()
+                time.sleep(0.005)
+            assert condition(), "Dhan GUI condition timed out"
+
+        def cleanup():
+            window._unified_core_shutdown_requested = True
+            window._shutdown_reason = "Offline Dhan GUI QA"
